# Fleet Management System - Environment Variables Example

# Secret key used for signing JWT authentication tokens. Set to a long, random string in production.
JWT_SECRET=change-me-to-a-long-random-string

# Telemetry API Key for machine-to-machine GPS ingest (MeshSat gateway, cellular trackers).
# The api service validates incoming telemetry against this value via the `x-api-key`
# header, and the meshsat-relay / teltonika-relay services send it as their FMS_API_KEY.
# Generate a strong, unique key — do NOT keep the old development placeholder
# (dev-telemetry-key-12345) in production:
#   openssl rand -hex 32
TELEMETRY_API_KEY=replace-with-openssl-rand-hex-32

# Bearer token for the rich Teltonika FMB125 JSON ingest webhook
# (POST /api/telemetry/ingest). The MeshSat gateway relay sends it as
# `Authorization: Bearer <token>`; the api service validates it with a
# timing-safe comparison. This is a separate secret from TELEMETRY_API_KEY.
# Generate a strong value and set it in your deployment environment
# (e.g. Coolify → api service → Environment Variables) — the client-facing
# telemetry views and the ingest webhook will reject requests without it:
#   openssl rand -hex 32
TELEMETRY_INGEST_TOKEN=replace-with-openssl-rand-hex-32

# Fuel refuel/drain detection thresholds, in litres. A change in the reported
# fuel level smaller than the threshold is treated as sensor jitter (rough
# roads) and ignored; only swings at or above it raise RULE_REFUEL_DETECTED /
# RULE_FUEL_DRAIN. Both default to 5 when unset.
FUEL_REFUEL_MIN_L=5
FUEL_DRAIN_MIN_L=5

# Offline watchdog window, in minutes. A device whose `last_seen_at` is older
# than this is reported as offline (`online: false`) by GET /api/telemetry/latest
# and GET /api/telemetry/features/:imei. Defaults to 15 when unset.
DEVICE_OFFLINE_MINUTES=15

# Remote device configuration/control (Teltonika Codec 12: setparam, setdigout).
# The api service queues commands in `device_commands`, then POSTs
# {"imei":"<15-digit>","command":"<teltonika-cmd>"} to ${MESHSAT_CMD_URL}/api/cmd
# with `Authorization: Bearer ${MESHSAT_CMD_TOKEN}`. The meshsat.dspng.space VPS
# queues the command and delivers it to the tracker over its next TCP session (5027).
MESHSAT_CMD_URL=https://meshsat.dspng.space
# Set in Coolify (the deployment environment) — DO NOT commit the real secret here.
MESHSAT_CMD_TOKEN=<set-in-coolify-environment>

# Live Fleet Map (server-side Basic-auth proxy). The MeshSat map is
# password-protected (username `admin`); a browser cannot send a Basic
# `Authorization` header from inside an iframe, so the api service proxies
# /api/meshsat-map/* and injects `Authorization: Basic base64(MESHSAT_MAP_AUTH)`
# server-side — the credential never reaches the browser. Set the credential in
# Coolify only — DO NOT commit it. MESHSAT_MAP_ORIGIN defaults to
# https://meshsat.dspng.space when unset.
MESHSAT_MAP_ORIGIN=https://meshsat.dspng.space
# Format "username:password" (e.g. admin:<password>).
MESHSAT_MAP_AUTH=<set-in-coolify-environment>
# Basemap for the proxied map. OpenStreetMap's volunteer tile servers return
# "403 Access blocked" tiles for this deployment, so the proxy rewrites the
# map's OSM tile URL to this CDN-backed template (default: Esri World Street Map,
# https://server.arcgisonline.com/ArcGIS/rest/services/World_Street_Map/MapServer/tile/{z}/{y}/{x}).
# For production/commercial use, point this at a licensed provider (CARTO with
# a `?key=`, MapTiler, Thunderforest, ...) and keep the attribution below.
# Leave unset for the default.
MESHSAT_MAP_TILE_URL=
# Attribution HTML shown on the map; must stay visible for the tile provider.
MESHSAT_MAP_TILE_ATTRIBUTION=

# Optional *alternative* to the proxy: the MeshSat map also accepts a
# shared-secret token (query param `key`), handed to the SPA via
# GET /api/meshsat/map-url (behind FMS auth). See MESHSAT_INTEGRATION.md §7.1.
# Set in Coolify only — DO NOT commit it.
MESHSAT_MAP_TOKEN=<set-in-coolify-environment>

# Allowed CORS origin for web app requests to the API. Set to your public frontend domain.
CORS_ORIGIN=https://your-domain.example

# Maximum allowed variance percentage for inventory reconciliation threshold (e.g. 0.5 for 0.5%).
MAX_ALLOWED_VARIANCE_PCT=0.5

# Optional MapTiler key for web frontend basemap tiles
VITE_MAPTILER_KEY=

# Optional web build-time override for the Live Fleet Map iframe URL. When set,
# the SPA embeds this MeshSat map URL directly instead of routing through the
# server-side Basic-auth proxy (/api/meshsat-map/map). Leave unset so the proxy
# injects the credential; set it only for an unauthenticated MeshSat map.
VITE_MESHSAT_MAP_URL=
