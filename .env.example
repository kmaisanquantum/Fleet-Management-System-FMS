# Fleet Management System - Environment Variables Example

# Secret key used for signing JWT authentication tokens. Set to a long, random string in production.
JWT_SECRET=change-me-to-a-long-random-string

# Telemetry API Key for machine-to-machine GPS ingest (e.g. MeshSat gateway, cellular trackers).
# The MeshSat relay authenticates to the FMS ingest endpoint (POST /api/v1/gps/positions)
# with this key via the `x-api-key` header. Replace the development default with a strong,
# random value before any non-local deployment, e.g. generate one with:
#   openssl rand -hex 32
# Keep this identical for both the `api` and `meshsat-relay` services (single env var).
TELEMETRY_API_KEY=change-me-to-a-long-random-telemetry-key

# Allowed CORS origin for web app requests to the API. Set to your public frontend domain.
CORS_ORIGIN=https://your-domain.example

# Maximum allowed variance percentage for inventory reconciliation threshold (e.g. 0.5 for 0.5%).
MAX_ALLOWED_VARIANCE_PCT=0.5

# Optional MapTiler key for web frontend basemap tiles
VITE_MAPTILER_KEY=
