# MeshSat Relay Environment Variables

PORT=6055
FMS_URL=https://fleet.dspng.tech
# Must match TELEMETRY_API_KEY used by the api service (x-api-key).
# Generate a strong key with: openssl rand -hex 32
# Do not use the development placeholder (dev-telemetry-key-12345) in production.
FMS_API_KEY=replace-with-openssl-rand-hex-32

# Preferred telemetry forward target: POST ${FMS_URL}/api/telemetry/ingest with
# `Authorization: Bearer <token>`. When set, the relay uses the rich Bearer
# ingest webhook; if it is missing (or the endpoint returns 404/401) the relay
# falls back to the legacy x-api-key positions endpoint
# (POST ${FMS_URL}/api/v1/gps/positions) so old deployments keep working.
# Must match TELEMETRY_INGEST_TOKEN on the api service.
TELEMETRY_INGEST_TOKEN=replace-with-openssl-rand-hex-32

# Shared secret for the command-queue endpoint (POST /api/cmd). The api service
# sends it as `x-cmd-token` when dispatching remote Codec-12 commands. Accepts
# either `x-cmd-token` or `Authorization: Bearer <token>`.
# Must match MESHSAT_CMD_TOKEN on the api service.
MESHSAT_CMD_TOKEN=replace-with-openssl-rand-hex-32

