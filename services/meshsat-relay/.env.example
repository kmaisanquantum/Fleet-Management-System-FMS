# MeshSat Relay Environment Variables

PORT=6055
FMS_URL=https://fleet.dspng.tech
# Must match TELEMETRY_API_KEY used by the api service (x-api-key).
# Generate a strong key with: openssl rand -hex 32
# Do not use the development placeholder (dev-telemetry-key-12345) in production.
FMS_API_KEY=replace-with-openssl-rand-hex-32
