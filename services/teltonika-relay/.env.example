# Teltonika Relay Environment Variables

# Teltonika AVL TCP protocol port (configure the FMB125 server port to match)
PORT=6056
# HTTP health endpoint port
HEALTH_PORT=6057
FMS_URL=https://fleet.dspng.tech
# Must match TELEMETRY_API_KEY in apps/api/.env (shared with meshsat-relay)
FMS_API_KEY=dev-telemetry-key-12345
