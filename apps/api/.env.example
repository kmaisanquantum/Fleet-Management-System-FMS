# Fleet Management System - API Service Environment Variables Example
#
# Copy to apps/api/.env for local development. The full deployment environment
# (JWT_SECRET, TELEMETRY_API_KEY, CORS_ORIGIN, ...) is documented in the
# repository root `.env.example`; this file consolidates the api-service
# variables for the Teltonika telemetry + Live Fleet Map (MeshSat) integration
# so a standalone api deployment can find them in one place.

# Bearer token for the rich Teltonika FMB125 JSON ingest webhook
# (POST /api/telemetry/ingest). The MeshSat gateway relay sends it as
# `Authorization: Bearer <token>`; the api service validates it with a
# timing-safe comparison. Separate secret from TELEMETRY_API_KEY. Generate with
# `openssl rand -hex 32` and set it in Coolify (api service) — DO NOT commit.
TELEMETRY_INGEST_TOKEN=

# Remote device configuration/control (Teltonika Codec 12). The api service
# queues commands in `device_commands`, then POSTs
# {"imei":"<15-digit>","command":"<teltonika-cmd>"} to ${MESHSAT_API_URL}/api/cmd
# with `Authorization: Bearer ${MESHSAT_API_KEY}`. Defaults to
# https://meshsat.dspng.space when unset. Set the key in Coolify — DO NOT commit.
# MESHSAT_CMD_URL / MESHSAT_CMD_TOKEN are accepted as fallbacks.
MESHSAT_API_URL=https://meshsat.dspng.space
MESHSAT_API_KEY=
MESHSAT_CMD_URL=
MESHSAT_CMD_TOKEN=

# Preferred Teltonika Bridge contract: POST ${MESHSAT_BRIDGE_URL}/api/devices/:imei/command
# with {"imei","command","command_type","command_id"} and a Bearer token. Takes
# precedence over MESHSAT_API_URL / MESHSAT_CMD_URL when set.
MESHSAT_BRIDGE_URL=
MESHSAT_BRIDGE_TOKEN=
# Command delivery timeout in milliseconds (default 5000).
MESHSAT_TIMEOUT_MS=5000

# MeshSat map origin. Defaults to https://meshsat.dspng.space when unset.
MESHSAT_MAP_ORIGIN=https://meshsat.dspng.space

# HTTP Basic auth credential the FMS proxy (/api/meshsat-map/*) injects when
# fetching the password-protected MeshSat map and its data endpoint, so the
# browser iframe never hits the login wall. Format "username:password"
# (e.g. admin:<password>). Set in Coolify (the deployment environment) —
# DO NOT commit the real value.
MESHSAT_MAP_AUTH=

# Basemap used by the proxied map. OSM's volunteer tile servers return
# "403 Access blocked" tiles for this deployment, so the proxy rewrites the
# map's OSM tile URL to this CDN-backed template. Default (when unset):
# https://server.arcgisonline.com/ArcGIS/rest/services/World_Street_Map/MapServer/tile/{z}/{y}/{x}
# For production/commercial use, point this at a licensed provider (CARTO with
# a `?key=`, MapTiler, Thunderforest, ...).
MESHSAT_MAP_TILE_URL=
# Attribution HTML shown on the map; must stay visible for the tile provider.
MESHSAT_MAP_TILE_ATTRIBUTION=

# Shared secret for the token-param *alternative* to the proxy (see
# MESHSAT_INTEGRATION.md §7.1); only used by the tokenized-URL endpoint
# GET /api/meshsat/map-url. Optional. Set in Coolify — DO NOT commit the value.
MESHSAT_MAP_TOKEN=
