# Fleet Management System - API Service Environment Variables Example
#
# Copy to apps/api/.env for local development. The full deployment environment
# (JWT_SECRET, TELEMETRY_API_KEY, TELEMETRY_INGEST_TOKEN, MESHSAT_CMD_URL,
# MESHSAT_CMD_TOKEN, CORS_ORIGIN, ...) is documented in the repository root
# `.env.example`; this file covers the api service variables added for the
# Live Fleet Map (MeshSat) integration.

# MeshSat map origin. Defaults to https://meshsat.dspng.space when unset.
MESHSAT_MAP_ORIGIN=https://meshsat.dspng.space

# Shared secret appended to the MeshSat map URL as `?key=<token>` so the
# password-protected map (and the data endpoint it polls) loads inside the FMS
# iframe without a login wall. Set in Coolify (the deployment environment) —
# DO NOT commit the real secret.
MESHSAT_MAP_TOKEN=
