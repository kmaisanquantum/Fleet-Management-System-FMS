# Production build environment (used by `vite build` / the web Docker image).
# VITE_* values are public and inlined into the client bundle at build time.

# MeshSat map iframe URL — the same-origin reverse-proxied path (see
# apps/web/infra.nginx.conf). A relative URL resolves against the FMS origin, so
# the MeshSat login state is first-party and is sent inside the iframe. A direct
# cross-site URL (https://meshsat.dspng.space/map) drops third-party cookies and
# shows the MeshSat login page instead of the map.
VITE_MESHSAT_MAP_URL=/meshsat/map
