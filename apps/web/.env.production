# Production build environment (used by `vite build` / the web Docker image).
# VITE_* values are public and inlined into the client bundle at build time.

# MeshSat map iframe URL — must be the same-domain reverse-proxied path
# (see apps/web/infra.nginx.conf) so the MeshSat session cookie is first-party
# and is sent inside the iframe. A direct cross-site URL drops third-party
# cookies and shows the MeshSat login page instead of the map.
VITE_MESHSAT_MAP_URL=https://fleet.dspng.tech/meshsat/map
