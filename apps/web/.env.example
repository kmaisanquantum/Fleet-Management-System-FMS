# Fleet Management System - Web App Environment Variables Example

# Optional MapTiler API Key for vector/raster tile layer on Live Fleet Map.
# If omitted, defaults to keyless Carto Voyager raster tiles.
VITE_MAPTILER_KEY=

# Optional override for the Live Fleet Map iframe URL. When set, the page
# embeds this MeshSat map URL directly instead of routing through the FMS
# server-side Basic-auth proxy (/api/meshsat-map/map). Leave unset for the
# password-protected MeshSat map so the proxy injects the credential; set it
# only for an unauthenticated MeshSat deployment.
VITE_MESHSAT_MAP_URL=

# Sign users out after this many minutes without mouse, keyboard, touch, or
# scroll activity. They are returned to the login page and can sign in again.
# Defaults to 30 when unset. This is a build-time Vite variable, so rebuild the
# web app after changing it.
VITE_IDLE_TIMEOUT_MINUTES=30
