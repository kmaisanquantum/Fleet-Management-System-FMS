# Fleet Management System - Web App Environment Variables Example

# Optional MapTiler API Key for vector/raster tile layer on Live Fleet Map.
# If omitted, defaults to keyless Carto Voyager raster tiles.
VITE_MAPTILER_KEY=

# Optional fallback MeshSat map URL for the Live Fleet Map page. The page
# normally loads a tokenized URL from the FMS API (GET /api/meshsat/map-url,
# which injects the shared secret server-side); this value is only used if that
# request fails, in which case the MeshSat password wall may appear.
# Defaults to https://meshsat.dspng.space/map when omitted.
VITE_MESHSAT_MAP_URL=https://meshsat.dspng.space/map
