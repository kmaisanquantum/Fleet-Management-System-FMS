# Fleet Management System - Web App Environment Variables Example

# Optional MapTiler API Key for vector/raster tile layer on Live Fleet Map.
# If omitted, defaults to keyless Carto Voyager raster tiles.
VITE_MAPTILER_KEY=

# MeshSat map iframe URL for the Live Fleet Map "MeshSat Mesh Map" tab.
# Use the SAME-DOMAIN reverse-proxied path (see apps/web/infra.nginx.conf),
# NOT the raw https://meshsat.dspng.space/map. The proxy makes the MeshSat
# session cookie first-party so it is actually sent inside the iframe;
# a direct cross-site iframe drops third-party cookies and shows the login page.
# Must be HTTPS in production to avoid mixed-content iframe blocking.
VITE_MESHSAT_MAP_URL=https://fleet.dspng.tech/meshsat/map
